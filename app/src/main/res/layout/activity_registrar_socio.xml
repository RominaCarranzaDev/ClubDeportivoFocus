<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:fillViewport="true"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvVolver"
            android:layout_marginTop="32dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_volver"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/registrar_titulo"
            android:textColor="@color/black"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/registrar_subtitulo"
            android:textColor="@color/black"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/rgTipoUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:checkedButton="@id/rbSocio">

            <!-- Opcion Socio -->
            <RadioButton
                android:id="@+id/rbSocio"
                style="@style/BotonOpcion"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:checked="true"
                android:paddingStart="32dp"
                android:paddingEnd="0dp"
                android:text="@string/registrar_opcion_socio" />

            <!-- Opcion No Socio -->
            <RadioButton
                android:id="@+id/rbNoSocio"
                style="@style/BotonOpcion"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:paddingStart="22dp"
                android:paddingEnd="0dp"
                android:text="@string/registrar_opcion_no_socio" />

        </RadioGroup>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbAptoFisico"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/registrar_cb_apto_fisico"
            android:textColor="@color/black"
            android:textSize="14sp"
            app:buttonTint="@color/primary" />

        <!-- Campo 1: Nombre -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/registrar_label_nombre"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/etNombre"
            style="@style/InputBase"
            android:layout_marginTop="6dp"
            android:hint="@string/registrar_hint_nombre"
            android:background="@drawable/bg_borde_texto"
            android:inputType="textCapWords"
            android:autofillHints="name"/>

        <!-- Campo 2: Apellido -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/registrar_label_apellido"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/etApellido"
            style="@style/InputBase"
            android:layout_marginTop="6dp"
            android:hint="@string/registrar_hint_apellido"
            android:background="@drawable/bg_borde_texto"
            android:inputType="textCapWords"
            android:autofillHints="name"/>

        <!-- Campo 3: DNI -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/registrar_label_dni"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/etDni"
            style="@style/InputBase"
            android:layout_marginTop="6dp"
            android:hint="@string/registrar_hint_dni"
            android:background="@drawable/bg_borde_texto"
            android:inputType="number"
            tools:ignore="Autofill"/>

        <!-- Campo 4: Fecha de Nacimiento -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/registrar_label_fecha_nacimiento"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/etFechaNacimiento"
            style="@style/InputBase"
            android:layout_marginTop="6dp"
            android:hint="@string/registrar_hint_fecha_nacimiento"
            android:background="@drawable/bg_borde_texto"
            android:inputType="date"
            tools:ignore="Autofill" />

        <!-- Campo 5: Correo Electronico -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/registrar_label_correo"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/etCorreo"
            style="@style/InputBase"
            android:layout_marginTop="6dp"
            android:hint="@string/registrar_hint_correo"
            android:background="@drawable/bg_borde_texto"
            android:inputType="textEmailAddress"
            android:autofillHints="emailAddress"/>

        <!-- Boton Guardar Registro -->
        <Button
            android:id="@+id/btnGuardarRegistro"
            style="@style/ButtonPrimaryL"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="@string/registrar_btn_guardar" />

    </LinearLayout>

</ScrollView>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvVolver"
            android:layout_marginTop="32dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_volver"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Registrar"
            android:textColor="@color/black"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Completa los datos para registrar el ingreso al club"
            android:textColor="@color/black"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/rgTipoUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:checkedButton="@id/rbSocio">

            <!-- Opcion Socio -->
            <RadioButton
                android:id="@+id/rbSocio"
                style="@style/BotonOpcion"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:checked="true"
                android:paddingStart="32dp"
                android:text="Socio" />

            <!-- Opcion No Socio -->
            <RadioButton
                android:id="@+id/rbNoSocio"
                style="@style/BotonOpcion"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:paddingStart="22dp"
                android:text="No Socio" />

        </RadioGroup>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbAptoFisico"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Presentó Apto Físico"
            android:textColor="@color/black"
            android:textSize="14sp"
            app:buttonTint="@color/primary" />

        <!-- Campo 1: Nombre -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="* NOMBRE"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/etNombre"
            style="@style/InputBase"
            android:layout_marginTop="6dp"
            android:hint="Juan"
            android:background="@drawable/bg_borde_texto"
            android:inputType="textCapWords" />

        <!-- Campo 2: Apellido -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="* APELLIDO"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/etApellido"
            style="@style/InputBase"
            android:layout_marginTop="6dp"
            android:hint="Perez"
            android:background="@drawable/bg_borde_texto"
            android:inputType="textCapWords" />

        <!-- Campo 3: DNI -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="* DOCUMENTO NACIONAL DE IDENTIDAD (DNI)"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/etDni"
            style="@style/InputBase"
            android:layout_marginTop="6dp"
            android:hint="12345678"
            android:background="@drawable/bg_borde_texto"
            android:inputType="number" />

        <!-- Campo 4: Fecha de Nacimiento -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="* FECHA DE NACIMIENTO"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/etFechaNacimiento"
            style="@style/InputBase"
            android:layout_marginTop="6dp"
            android:hint="07/11/2003"
            android:background="@drawable/bg_borde_texto"
            android:inputType="date" />

        <!-- Campo 5: Correo Electronico -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="* CORREO ELECTRONICO"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/etCorreo"
            style="@style/InputBase"
            android:layout_marginTop="6dp"
            android:hint="correo@ejemplo.com"
            android:background="@drawable/bg_borde_texto"
            android:inputType="textEmailAddress" />

        <!-- Boton Guardar Registro -->
        <Button
            android:id="@+id/btnGuardarRegistro"
            style="@style/ButtonPrimaryL"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="GUARDAR REGISTRO" />

    </LinearLayout>

</ScrollView>
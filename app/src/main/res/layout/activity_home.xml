<?xml version="1.0" encoding="utf-8"?>
<LinearLayout

    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    tools:context=".HomeActivity">

    <!-- Encabezado -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gradient"
        android:paddingHorizontal="24dp"
        android:orientation="vertical"
        android:paddingTop="70dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_welcome"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/home_user_role"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingTop="64dp"
        tools:ignore="TextContrastCheck,VisualLintTextFieldSize"
        android:paddingBottom="60dp">


        <!-- Boton 1 Registrar Socio -->
        <Button
            android:id="@+id/btnRegistrarSocio"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/primary"
            android:text="@string/btn_registrar_socio"
            android:textColor="@color/white"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_registrar_socio"
            app:iconGravity="textStart"
            app:iconPadding="20dp"
            app:iconTint="@color/white" />

        <!-- Boton 2 Cobro de cuotas -->
        <Button
            android:id="@+id/btnCobroCuotas"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/primary"
            android:text="@string/btn_cobro_cuotas"
            android:textColor="@color/white"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_cobro_cuotas"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@color/white" />

        <!-- Boton 3 Vencimientos -->
        <Button
            android:id="@+id/btnVencimientos"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/primary"
            android:text="@string/btn_vencimientos"
            android:textColor="@color/white"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_vencimientos"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@color/white" />

        <!-- Boton 4 Carnets -->
        <Button
            android:id="@+id/btnCarnets"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/primary"
            android:text="@string/btn_carnets"
            android:textColor="@color/white"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_carnets"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@color/white" />

        <!-- Boton 5 Historial Pagos -->
        <Button
            android:id="@+id/btnHistorialPagos"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/primary"
            android:text="@string/btn_historial_pagos"
            android:textColor="@color/white"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_historial"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@color/white" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- Cerrar Sesion -->
        <TextView
            android:id="@+id/tvCerrarSesion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="80dp"
            android:text="@string/btn_cerrar_sesion"
            android:textColor="@color/secondary"
            android:textSize="20sp"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/ic_logout"
            android:drawablePadding="8dp"
            app:drawableTint="@color/primary"
            android:gravity="center_vertical"/>

    </LinearLayout>

</LinearLayout>
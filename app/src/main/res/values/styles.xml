<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ButtonBase" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">60dp</item>

        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>

        <item name="cornerRadius">12dp</item>
        <item name="strokeWidth">0dp</item>

        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">24dp</item>
        <item name="iconGravity">start</item>
        <item name="iconPadding">16dp</item>
        <item name="iconTint">@color/white</item>

    </style>

    <style name="ButtonPrimaryS" parent="ButtonBase">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:textColor">@color/white</item>
        <item name="strokeColor">@color/secondary</item>
        <item name="backgroundTint">@color/primary</item>

    </style>

    <style name="ButtonPrimaryL" parent="ButtonBase">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/primary</item>

    </style>

    <style name="ButtonOutlineS" parent="ButtonBase">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:textColor">@color/primary</item>
        <item name="strokeColor">@color/secondary</item>
    </style>

    <style name="ButtonOutlineL" parent="ButtonBase">
        <item name="android:textColor">@color/primary</item>
        <item name="strokeColor">@color/secondary</item>
    </style>

    <style name="ButtonDisabled" parent="ButtonBase">
        <item name="android:textColor">@color/disabled</item>
        <item name="strokeColor">@color/disabled</item>
    </style>

    <style name="labelSuccess">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/success</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/label_success</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="labelWarning">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/secondary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/label_warning</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="labelDanger">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/danger</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/label_danger</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- MOLDE PARA CAMPOS DE TEXTO (EditText) -->
    <style name="InputBase">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">50dp</item>
    <item name="android:background">@drawable/bg_rounded_input</item>
    <item name="android:paddingHorizontal">16dp</item>
    <item name="android:textColor">@color/black</item>
    <item name="android:textSize">16sp</item>
    </style>

    <!-- MOLDE PARA LOS BOTONES DE OPCIÓN (Socio / No Socio) -->
    <style name="BotonOpcion">
    <!-- El fondo y color de letras que armamos en drawable-->
    <item name="android:background">@drawable/bg_selector_opciones</item>
    <item name="android:textColor">@color/text_selector_opciones</item>
    <item name="android:textSize">16sp</item>
    <item name="android:textStyle">bold</item>

    <!-- 1. APAGAMOS forzado del circulito de la izquierda -->
    <item name="android:button">@null</item>

    <!-- 2. Dibujamos un ícono de circulito pegado al lado del texto -->
    <item name="android:drawableStart">?android:attr/listChoiceIndicatorSingle</item>

    <!-- 3. Le damos un espacio de 8dp entre el circulito nuevo y la palabra -->
    <item name="android:drawablePadding">8dp</item>


    <!-- 5. Pintamos el circulito nuevo para que cambie de color (Blanco/Gris) -->
    <item name="android:drawableTint">@color/button_tint_selector</item>
    <item name="drawableTint">@color/button_tint_selector</item>
</style>
    <!--Estilo para los buscadores-->
    <style name="InputSearch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:background">@drawable/bg_search</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">16sp</item>
        <item name="android:drawableEnd">@android:drawable/ic_menu_search</item>
        <item name="android:drawablePadding">8dp</item>
    </style>

    <!--Estilo para los radio button-->
    <style name="RbOpcion">
        <item name="android:background">@drawable/rb_options</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">16sp</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <!-- Color del ícono -->
        <item name="android:drawableTint">@color/rb_tint_selector</item>
        <item name="drawableTint">@color/rb_tint_selector</item>
        <!-- Color del círculo -->
        <item name="buttonTint">@color/rb_tint_selector</item>
        <item name="android:button">@null</item>
    </style>

</resources>